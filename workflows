
name: Build Eclipse Android APK

on:
  workflow_dispatch:
  push:
    branches: [main, master]

permissions:
  contents: read

jobs:
  build:
    runs-on: ubuntu-latest
    steps:
      - name: Download repository files
        uses: actions/checkout@v4

      - name: Set up Java
        uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: '17'

      - name: Set up Node.js
        uses: actions/setup-node@v4
        with:
          node-version: '20'

      - name: Extract Eclipse project ZIP
        run: |
          mkdir -p extracted
          ZIP_FILE="$(find . -maxdepth 3 -type f -iname '*.zip' ! -path './extracted/*' | head -n 1)"
          if [ -z "$ZIP_FILE" ]; then
            echo "ERROR: No project ZIP found in the repository."
            exit 1
          fi
          unzip -q "$ZIP_FILE" -d extracted
          PROJECT_DIR="$(dirname "$(find extracted -type f -name package.json -print -quit)")"
          if [ "$PROJECT_DIR" = "extracted" ] || [ ! -f "$PROJECT_DIR/package.json" ]; then
            echo "ERROR: Could not find the Eclipse package.json."
            exit 1
          fi
          echo "PROJECT_DIR=$PROJECT_DIR" >> "$GITHUB_ENV"

      - name: Install dependencies
        run: cd "$PROJECT_DIR" && npm install

      - name: Prepare Android project
        run: |
          cd "$PROJECT_DIR"
          npm run prepare:android
          npx cap add android
          node tools/patch-android-manifest.mjs
          npx cap sync android

      - name: Build APK
        run: |
          cd "$PROJECT_DIR"
          chmod +x android/gradlew
          cd android
          ./gradlew assembleDebug

      - name: Upload installable APK
        uses: actions/upload-artifact@v4
        with:
          name: Eclipse-Android-APK
          path: ${{ env.PROJECT_DIR }}/android/app/build/outputs/apk/debug/app-debug.apk
          if-no-files-found: error
          retention-days: 14
